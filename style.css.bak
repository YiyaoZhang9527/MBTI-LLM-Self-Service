:root {
    /* Starry Night Palette */
    --primary-color: #F5D020;
    /* Star Gold */
    --primary-hover: #F5A623;
    /* Deep Gold */
    --secondary-color: #4FACFE;
    /* Sky Blue */
    --background-start: #0B1026;
    /* Midnight Blue */
    --background-end: #2B32B2;
    /* Deep Blue */
    --card-background: rgba(15, 23, 42, 0.6);
    /* Glassmorphism */
    --text-primary: #F0F0F0;
    /* Cream White */
    --text-secondary: #B0B0B0;
    /* Soft Grey */
    --border-color: rgba(79, 172, 254, 0.3);
    /* Subtle Blue Border */
    --shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    --glow: 0 0 15px rgba(245, 208, 32, 0.5);
    --border-radius: 16px;
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Lato', sans-serif;
}

/* Fallback for older browsers */
body {
    background-color: #0B1026;
    color: #F0F0F0;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    background: radial-gradient(circle at 50% 0%, var(--background-end), var(--background-start));
    background-attachment: fixed;
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
}

#app {
    min-height: 100vh;
    position: relative;
}

.screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.screen.active {
    opacity: 1;
    visibility: visible;
}

.container {
    max-width: 600px;
    width: 100%;
    padding: 20px;
    text-align: center;
}

/* Start Screen */
#start-screen h1 {
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--primary-color);
    text-shadow: 0 0 20px rgba(245, 208, 32, 0.3);
    margin-bottom: 24px;
    letter-spacing: 2px;
}

#start-screen p {
    font-size: 1.3rem;
    color: var(--text-secondary);
    margin-bottom: 48px;
    font-weight: 300;
}

/* Buttons */
.primary-btn,
.secondary-btn {
    padding: 16px 40px;
    border: none;
    border-radius: 30px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.primary-btn {
    background: var(--primary-color);
    color: #0B1026;
    box-shadow: var(--glow);
}

.primary-btn:hover {
    transform: translateY(-2px) scale(1.05);
    background: var(--primary-hover);
    box-shadow: 0 0 25px rgba(245, 208, 32, 0.7);
}

.secondary-btn {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    backdrop-filter: blur(5px);
}

.secondary-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: var(--primary-color);
    transform: translateY(-2px);
}

/* Question Screen */
.progress-bar {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    margin-bottom: 40px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
    width: 0%;
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 3px;
    box-shadow: 0 0 10px rgba(79, 172, 254, 0.5);
}

.question-header {
    margin-bottom: 24px;
}

#question-number {
    color: var(--text-secondary);
    font-weight: 500;
}

.question-text {
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.6;
    margin-bottom: 40px;
    color: var(--text-primary);
}

.answer-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.option {
    padding: 24px;
    background: var(--card-background);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    backdrop-filter: blur(10px);
    color: var(--text-primary);
}

.option:hover {
    border-color: var(--primary-color);
    background: rgba(245, 208, 32, 0.1);
    transform: translateX(4px);
    box-shadow: 0 0 15px rgba(245, 208, 32, 0.1);
}

.option.selected {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: #0B1026;
    transform: translateX(8px);
    box-shadow: 0 0 20px rgba(245, 208, 32, 0.4);
    font-weight: 700;
}

.option .label {
    font-size: 1.1rem;
}

/* Result Screen */
#result-screen h2 {
    font-size: 2.5rem;
    margin-bottom: 24px;
    color: var(--text-primary);
}

.mbti-type {
    font-family: var(--font-heading);
    font-size: 5rem;
    font-weight: 700;
    color: var(--primary-color);
    margin-bottom: 40px;
    text-transform: uppercase;
    letter-spacing: 12px;
    text-shadow: 0 0 30px rgba(245, 208, 32, 0.4);
}

.percentages {
    background: var(--card-background);
    border-radius: var(--border-radius);
    padding: 32px;
    margin-bottom: 40px;
    box-shadow: var(--shadow);
    border: 1px solid var(--border-color);
    backdrop-filter: blur(10px);
}

.percentage-row {
    display: flex;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
}

.percentage-row:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
}

.dimension-label {
    width: 60px;
    font-weight: 600;
    color: var(--text-secondary);
}

.percentage-bar {
    flex: 1;
    height: 8px;
    background: var(--border-color);
    border-radius: 4px;
    margin: 0 16px;
    overflow: hidden;
    position: relative;
}

.percentage-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
    border-radius: 4px;
    transition: width 0.5s ease;
}

.percentage-values {
    display: flex;
    justify-content: space-between;
    width: 120px;
    font-weight: 500;
    font-size: 0.9rem;
}

/* Responsive Design */
@media (max-width: 768px) {
    .container {
        padding: 16px;
    }

    #start-screen h1 {
        font-size: 2.5rem;
    }

    .question-text {
        font-size: 1.2rem;
    }

    .mbti-type {
        font-size: 3rem;
        letter-spacing: 4px;
    }

    .percentage-values {
        width: 100px;
        font-size: 0.8rem;
    }
}

@media (max-width: 480px) {
    .container {
        padding: 12px;
    }

    #start-screen h1 {
        font-size: 2rem;
    }

    .question-text {
        font-size: 1.1rem;
    }

    .option {
        padding: 16px;
    }

    .mbti-type {
        font-size: 2.5rem;
        letter-spacing: 2px;
    }

    .percentages {
        padding: 16px;
    }
}